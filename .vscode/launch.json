{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug on Board",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "host.docker.internal:3333",
            "interface": "swd",
            "device": "STM32C092RC",
            "runToEntryPoint": "main"
        }
    ]
}
